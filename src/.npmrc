# Supply-chain hardening for the repo-local Markdown tooling (markdownlint-cli2).
# Applies to every `npm install` run in src/ or with `--prefix src`.

# Dependency lifecycle scripts never run: nothing in the markdownlint-cli2
# tree needs one, and a compromised release's postinstall cannot execute.
ignore-scripts=true

# Skip versions published less than 7 days ago (matches Dependabot's cooldown),
# so a compromised or yanked release is usually caught first. npm 11.10+
# honours it; older npm (e.g. CI's Node 22 npm 10) ignores it silently.
min-release-age=7
